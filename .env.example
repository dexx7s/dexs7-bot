# Salin file ini menjadi ".env" lalu isi dengan nilai milikmu sendiri.
# JANGAN pernah membagikan token bot asli ke publik.

# Token bot dari Discord Developer Portal (Bot > Reset Token)
DISCORD_TOKEN=isi_token_bot_kamu_di_sini

# Client ID aplikasi (General Information > Application ID)
CLIENT_ID=isi_client_id_di_sini

# (Opsional) Guild/Server ID untuk deploy command secara instan ke satu server saat development.
# Kosongkan jika ingin deploy secara global (butuh waktu hingga 1 jam untuk update).
GUILD_ID=isi_guild_id_di_sini
